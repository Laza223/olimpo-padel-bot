# Copiar a .env y completar. .env NUNCA se sube a git. Guía paso a paso: docs/operacion.md
OPENAI_API_KEY=
# Clave de Anthropic (Claude). Solo hace falta si BOT_MODEL empieza con "claude-" o si las pruebas (pnpm eval) corren con --eval-provider anthropic.
ANTHROPIC_API_KEY=
# Clave del panel y de la API de WAHA: inventá una larga, solo letras y números.
WAHA_API_KEY=
# Secreto con el que WAHA firma lo que le manda al bot: otra clave larga, solo letras y números.
WAHA_WEBHOOK_HMAC_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Latido de healthchecks.io (opcional: vacío = sin latido).
HEALTHCHECKS_PING_URL=
# openai = el cerebro de verdad. fake = un cerebro de mentira que no gasta nada (para probar).
# Con "openai" el proveedor lo decide BOT_MODEL: si empieza con "claude-" usa Anthropic (ANTHROPIC_API_KEY); si no, OpenAI (OPENAI_API_KEY). El valor se deja así también con Claude.
BOT_LLM=openai
# Modelo y esfuerzo del cerebro. El validado en el banco (9-oct) es Sonnet 5.5 en medium: poné los DOS, porque sin BOT_EFFORT queda en low y en low no pasó.
# Sin estas dos líneas el cerebro es gpt-6.1-sol en low (necesita OPENAI_API_KEY con saldo). Con Claude el esfuerzo es low, medium, high, xhigh o max.
BOT_MODEL=claude-sonnet-5-5
BOT_EFFORT=medium
# Quién transcribe los audios del cliente. local (por defecto) = Whisper en tu notebook, gratis: antes hay que bajar el modelo con "pnpm whisper:model". openai = gpt-transcribe: cuesta y necesita saldo.
# BOT_TRANSCRIBER=local
# Solo con BOT_TRANSCRIBER=openai: modelo que transcribe (opcional; sin esto: gpt-transcribe). Va siempre a OpenAI, aunque el cerebro sea claude-*: OPENAI_API_KEY tiene que estar igual.
# BOT_TRANSCRIBE_MODEL=
# Solo con BOT_TRANSCRIBER=local: dirección de Whisper (no se toca salvo que cambie la instalación) e hilos de CPU que usa (por defecto 4; lo lee docker compose desde este archivo).
# WHISPER_URL=http://whisper:8080
# WHISPER_THREADS=4
# Estos dos no se tocan salvo que cambie la instalación (nombres de los contenedores).
WAHA_URL=http://waha:3000
BOT_PUBLIC_WEBHOOK_URL=http://bot:8080/waha
